# init containers (grafana's chown-data, prometheus-operator's admission cert generator) need
# brief root/writable access to do their one job before the real container starts.
AVD-KSV-0001 exp:2027-08-31
AVD-KSV-0014 exp:2027-08-31
AVD-KSV-0022 exp:2027-08-31

# prometheus/alertmanager CRs need their operator-issued service account token to authenticate
# to the k8s API for service discovery - automountServiceAccountToken:false would break that.
AVD-KSV-0036 exp:2027-08-31

# kube-system-namespaced Services are intentional: the chart creates them to let prometheus
# scrape control-plane components (scheduler/controller-manager/etcd/kube-proxy/coredns) that
# aren't otherwise exposed via a normal Service - not a placement mistake.
AVD-KSV-0037 exp:2027-08-31

# every image here (quay.io, registry.k8s.io, ghcr.io) is the chart's own upstream default for
# an established, widely-deployed CNCF-ecosystem project - not an untrusted third party.
AVD-KSV-0125 exp:2027-08-31
